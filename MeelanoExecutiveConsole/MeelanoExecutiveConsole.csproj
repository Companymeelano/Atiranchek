<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeelanoExecutiveConsole</RootNamespace>
    <AssemblyName>MeelanoExecutiveConsole</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\meelano.ico</ApplicationIcon>
    <Version>1.1.6</Version>
    <AssemblyVersion>1.1.6.0</AssemblyVersion>
    <FileVersion>1.1.6.0</FileVersion>
    <Company>MEELANO</Company>
    <Product>MEELANO Executive Console</Product>
    <Description>Persian RTL executive dashboard with test-only, read-only SQL Server import.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeelanoExecutiveConsole.Core\MeelanoExecutiveConsole.Core.csproj" />
  </ItemGroup>
</Project>
