<Window x:Class="MeelanoExecutiveConsole.Views.SqlConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اتصال امن به SQL Server | MEELANO"
        Width="1100"
        Height="790"
        MinWidth="850"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid>
        <Border Background="{StaticResource WindowBackgroundBrush}" />
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0D191B" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اتصال مستقیم و فقط‌خواندنی به SQL Server" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="ورود امن · انتخاب دیتابیس · کشف schema · نگاشت راهنمایی‌شدهٔ چک و فروش"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#172624" BorderBrush="#344B41" BorderThickness="1"
                            CornerRadius="10" Padding="11,7" VerticalAlignment="Center">
                        <TextBlock Text="TLS الزامی · بدون ذخیرهٔ رمز" Foreground="{StaticResource GoldLightBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <TabControl x:Name="WizardTabs" Grid.Row="1" SelectedIndex="0">
                <TabItem x:Name="ConnectionTab" Header="۱ · اتصال و کشف ساختار">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <TextBlock Text="مقصد SQL Server" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="IP یا نام میزبان را اینجا وارد کنید؛ آدرس و رمز در کد برنامه یا فایل تنظیمات ذخیره نمی‌شوند."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="15" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="3">
                                        <TextBlock Text="IP / نام میزبان" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,5" />
                                        <TextBox x:Name="ServerHostBox" ToolTip="برای نمونه: 192.168.1.10 یا sql.example.local"
                                                 TextChanged="ConnectionField_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="3">
                                        <TextBlock Text="پورت TCP" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,5" />
                                        <TextBox x:Name="PortBox" Text="5050" FlowDirection="LeftToRight" TextChanged="ConnectionField_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="3">
                                        <TextBlock Text="روش ورود" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,5" />
                                        <ComboBox x:Name="AuthenticationCombo" SelectionChanged="Authentication_Changed">
                                            <ComboBoxItem Content="SQL Login · ورود همین بار" Tag="sql" />
                                            <ComboBoxItem Content="Windows Authentication" Tag="windows" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="3">
                                        <TextBlock Text="نام کاربری SQL" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,5" />
                                        <TextBox x:Name="UserNameBox" TextChanged="ConnectionField_Changed" />
                                    </StackPanel>

                                    <StackPanel x:Name="PasswordPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="3,10,3,3">
                                        <TextBlock Text="رمز SQL · این نوبت فقط در حافظه" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,5" />
                                        <PasswordBox x:Name="PasswordInput" PasswordChanged="ConnectionField_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="3,10,3,3">
                                        <Button x:Name="ConnectButton" Content="آزمون اتصال و فهرست دیتابیس‌ها" Style="{StaticResource GoldButtonStyle}"
                                                MinWidth="245" Click="Connect_Click" />
                                        <TextBlock x:Name="ConnectionStatusText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Background="#172320" BorderBrush="#425543"
                                            BorderThickness="1" CornerRadius="11" Padding="10" Margin="3,10,3,0">
                                        <TextBlock Text="برای رعایت حداقل دسترسی، از حسابی با مجوز SELECT فقط روی دیتابیس/نماهای گزارش استفاده کنید. اتصال رمزگذاری و اعتبار گواهی TLS بررسی می‌شود؛ گواهی نامعتبر را دور نمی‌زنیم."
                                                   Foreground="{StaticResource GoldLightBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="15" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="پایگاه داده" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="فقط دیتابیس‌هایی نمایش داده می‌شوند که حساب SQL به آن‌ها دسترسی دارد."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="DatabaseCombo" Width="260" IsEnabled="False" SelectionChanged="Database_SelectionChanged" />
                                        <Button x:Name="DiscoverButton" Content="کشف جدول‌ها و ستون‌ها" IsEnabled="False"
                                                Style="{StaticResource GoldButtonStyle}" Click="DiscoverSchema_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="260" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="2,0,2,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ساختار قابل‌دسترسی" FontSize="14" FontWeight="Bold" />
                                            <TextBlock Text="متادیتا نمایش داده می‌شود؛ هیچ ردیفی از دادهٔ تجاری در مرحلهٔ کشف خوانده نمی‌شود."
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="SchemaCountText" Grid.Column="1" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldLightBrush}" FontSize="10" />
                                    </Grid>
                                    <DataGrid x:Name="SchemaGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                              HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="150" />
                                            <DataGridTextColumn Header="نام جدول/نما" Binding="{Binding Name}" Width="220" />
                                            <DataGridTextColumn Header="نوع" Binding="{Binding ObjectType}" Width="120" />
                                            <DataGridTextColumn Header="ستون‌ها" Binding="{Binding ColumnsSummary}" Width="*" MinWidth="250" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="MappingTab" Header="۲ · نگاشت داده‌ها" IsEnabled="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <TextBlock Text="نگاشت شفاف ستون‌ها" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="برنامه نام جدول‌ها یا ستون‌های آتیران را حدس نمی‌زند. هر فیلد را انتخاب کنید، مقدارهای نوع/وضعیت را صریح نگاشت کنید و سپس پیش‌نمایش کامل را بارگذاری کنید."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="چک‌ها" FontSize="15" FontWeight="Bold" />
                                    <StackPanel Margin="0,8,0,4">
                                        <TextBlock Text="منبع جدول/نما" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CheckTableCombo" SelectionChanged="CheckTable_SelectionChanged" />
                                    </StackPanel>
                                    <UniformGrid Columns="2" Margin="-3,0,-3,0">
                                        <StackPanel Margin="3"><TextBlock Text="شمارهٔ یکتا · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckNumberField" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="نوع چک · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckKindField" SelectionChanged="CheckKindField_SelectionChanged" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="طرف حساب · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckPartyField" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="مبلغ · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckAmountField" SelectionChanged="CheckAmountField_SelectionChanged" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="واحد منبع مبلغ" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckAmountUnitCombo" SelectedIndex="0"><ComboBoxItem Content="— واحد را صریح انتخاب کنید —" /><ComboBoxItem Content="تومان (بدون تبدیل)" Tag="1" /><ComboBoxItem Content="ریال (تقسیم بر ۱۰ برای تومان)" Tag="0.1" /></ComboBox></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="سررسید · SQL/شمسی" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckDueDateField" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="وضعیت چک · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckStatusField" SelectionChanged="CheckStatusField_SelectionChanged" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="بانک · اختیاری" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckBankField" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="امتیاز ریسک ۰ تا ۱۰۰ · اختیاری" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="CheckRiskField" /></StackPanel>
                                    </UniformGrid>
                                    <Border Background="#0B1719" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="نگاشت مقدارهای نوع چک" FontWeight="SemiBold" FontSize="11" />
                                            <TextBlock Text="پیشنهادهای نوع ممکن است خالی بمانند؛ هر مقدار منبع را بررسی و صریحاً به دریافتی یا پرداختی وصل کنید، از جمله NULL."
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,6" />
                                            <DataGrid x:Name="KindMappingsGrid" Height="170" AutoGenerateColumns="False" CanUserAddRows="False"
                                                      CanUserDeleteRows="False" HeadersVisibility="Column" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0B1719" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="نگاشت مقدارهای وضعیت چک" FontWeight="SemiBold" FontSize="11" />
                                            <TextBlock Text="برای هر مقدار، یک وضعیت برنامه را انتخاب کنید؛ برنامه مقدار ناشناخته را خودکار به «در انتظار» تبدیل نمی‌کند."
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,6" />
                                            <DataGrid x:Name="StatusMappingsGrid" Height="190" AutoGenerateColumns="False" CanUserAddRows="False"
                                                      CanUserDeleteRows="False" HeadersVisibility="Column" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="فروش" FontSize="15" FontWeight="Bold" />
                                    <StackPanel Margin="0,8,0,4">
                                        <TextBlock Text="منبع جدول/نما" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4" />
                                        <ComboBox x:Name="SalesTableCombo" SelectionChanged="SalesTable_SelectionChanged" />
                                    </StackPanel>
                                    <UniformGrid Columns="2" Margin="-3,0,-3,0">
                                        <StackPanel Margin="3"><TextBlock Text="تاریخ فروش · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="SalesDateField" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="مشتری · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="SalesCustomerField" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="فروشنده · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="SalesSellerField" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="مبلغ فروش · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="SalesAmountField" SelectionChanged="SalesUnitField_SelectionChanged" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="واحد مبلغ/سود" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="SalesAmountUnitCombo" SelectedIndex="0"><ComboBoxItem Content="— واحد را صریح انتخاب کنید —" /><ComboBoxItem Content="تومان (بدون تبدیل)" Tag="1" /><ComboBoxItem Content="ریال (تقسیم بر ۱۰ برای تومان)" Tag="0.1" /></ComboBox></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="سود · لازم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="SalesProfitField" SelectionChanged="SalesUnitField_SelectionChanged" /></StackPanel>
                                        <StackPanel Margin="3"><TextBlock Text="وضعیت وصول · اختیاری" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /><ComboBox x:Name="SalesCollectionStatusField" /></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Background="#172320" BorderBrush="#425543" BorderThickness="1" CornerRadius="12" Padding="11">
                                <TextBlock Text="تاریخ‌های DATE/DATETIME به تقویم شمسی نمایش داده می‌شوند؛ متن YYYY/MM/DD با سال ۱۳۰۰ تا ۱۴۹۹ شمسی تفسیر می‌شود. ارقام و مبالغ پس از اعتبارسنجی در حافظه بارگذاری می‌شوند. فقط خواندن انجام می‌شود؛ هیچ UPDATE/INSERT/DELETE اجرا نمی‌شود."
                                           Foreground="{StaticResource GoldLightBrush}" FontSize="10" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="برای دادهٔ زنده، از حساب SQL کم‌دسترسی با SELECT روی Viewهای گزارش استفاده کنید."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="بستن" MinWidth="90" Click="Cancel_Click" />
                    <Button x:Name="ImportButton" Content="اعتبارسنجی و بارگذاری داده‌ها" IsEnabled="False"
                            Style="{StaticResource GoldButtonStyle}" Click="Import_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="LoadingOverlay" Panel.ZIndex="20" Visibility="Collapsed" Background="#E9081214">
            <Border Width="460" MinHeight="420" Padding="24" CornerRadius="24" Background="#101D20"
                    BorderBrush="#56634A" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#D8B66C" Opacity="0.28" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="همگام‌سازی امن داده‌ها" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="MEELANO · SQL READ-ONLY" FontSize="9" Foreground="{StaticResource GoldBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" FlowDirection="LeftToRight" />
                    <Grid Width="260" Height="235" Margin="0,9,0,0">
                        <Ellipse Width="190" Height="190" Fill="#193F3830" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect><BlurEffect Radius="23" /></Ellipse.Effect>
                        </Ellipse>
                        <Viewport3D x:Name="LoadingViewport" Width="250" Height="225" IsHitTestVisible="False" ClipToBounds="True" />
                        <TextBlock x:Name="LoadingPercentText" Text="۰٪" FontSize="25" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar x:Name="LoadingProgressBar" Minimum="0" Maximum="100" Value="0" Height="7" Margin="8,2,8,10"
                                 Foreground="{StaticResource GoldBrush}" Background="#203235" />
                    <TextBlock x:Name="LoadingStageText" Text="آماده‌سازی…" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="درصد بارگذاری بر اساس مرحله/ردیف‌های خوانده‌شده است؛ اطلاعات تجاری روی سرور تغییر نمی‌کند."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="12,8,12,12" />
                    <Button Content="لغو عملیات" HorizontalAlignment="Center" MinWidth="130" Click="CancelOperation_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
