<Window x:Class="MeelanoExecutiveConsole.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MEELANO | کنسول مدیران"
        Width="1380"
        Height="820"
        MinWidth="780"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Border Background="{DynamicResource WindowBackgroundBrush}" />
        <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-250,0,0,-300" Fill="{DynamicResource GlowBrush}" IsHitTestVisible="False" />

        <DockPanel Margin="12" LastChildFill="True">
            <Border DockPanel.Dock="Right"
                    Width="242"
                    Margin="0,0,14,0"
                    Padding="16"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,8,4,30" FlowDirection="RightToLeft">
                        <Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1">
                            <TextBlock Text="M" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource GoldLightBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="MEELANO" FontSize="15" FontWeight="Bold" FlowDirection="LeftToRight" />
                            <TextBlock Text="EXECUTIVE CONSOLE" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" FlowDirection="LeftToRight" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="فضای کاری" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   FontWeight="Bold" Margin="12,0,12,10" />
                        <RadioButton x:Name="NavDashboard" GroupName="MainNavigation" Tag="0" IsChecked="True"
                                     Style="{StaticResource NavigationRadioStyle}" Checked="Navigation_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource GoldGradientBrush}" BorderBrush="{DynamicResource GoldLightBrush}" BorderThickness="0.5" HorizontalAlignment="Right">
                                    <Border.Effect><DropShadowEffect Color="#D2A34F" BlurRadius="8" ShadowDepth="2" Opacity="0.25" /></Border.Effect>
                                    <Viewbox Width="15" Height="15"><Path Data="M 8,1 L 15,8 8,15 1,8 Z M 8,4 L 12,8 8,12 4,8 Z" Stroke="#173330" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" Text="نمای کلی" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavChecks" GroupName="MainNavigation" Tag="1"
                                     Style="{StaticResource NavigationRadioStyle}" Checked="Navigation_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource GoldGradientBrush}" BorderBrush="{DynamicResource GoldLightBrush}" BorderThickness="0.5" HorizontalAlignment="Right">
                                    <Border.Effect><DropShadowEffect Color="#D2A34F" BlurRadius="8" ShadowDepth="2" Opacity="0.25" /></Border.Effect>
                                    <Viewbox Width="15" Height="15"><Path Data="M 2,2 L 14,2 14,14 2,14 Z M 4,5 L 12,5 M 4,8 L 12,8 M 4,11 L 10,11" Stroke="#173330" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" Text="مرکز چک‌ها" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavSales" GroupName="MainNavigation" Tag="2"
                                     Style="{StaticResource NavigationRadioStyle}" Checked="Navigation_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource GoldGradientBrush}" BorderBrush="{DynamicResource GoldLightBrush}" BorderThickness="0.5" HorizontalAlignment="Right">
                                    <Border.Effect><DropShadowEffect Color="#D2A34F" BlurRadius="8" ShadowDepth="2" Opacity="0.25" /></Border.Effect>
                                    <Viewbox Width="15" Height="15"><Path Data="M 2,13 L 7,8 9,10 14,3 M 9,3 L 14,3 14,8" Stroke="#173330" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" Text="فروش و عملکرد" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavRadar" GroupName="MainNavigation" Tag="3"
                                     Style="{StaticResource NavigationRadioStyle}" Checked="Navigation_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource GoldGradientBrush}" BorderBrush="{DynamicResource GoldLightBrush}" BorderThickness="0.5" HorizontalAlignment="Right">
                                    <Border.Effect><DropShadowEffect Color="#D2A34F" BlurRadius="8" ShadowDepth="2" Opacity="0.25" /></Border.Effect>
                                    <Viewbox Width="15" Height="15"><Path Data="M 8,1 A 7,7 0 1 0 8,15 A 7,7 0 1 0 8,1 M 8,4 A 4,4 0 1 0 8,12 A 4,4 0 1 0 8,4 M 8,7 L 8,9" Stroke="#173330" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" Text="رادار نقدینگی" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavTreasury" GroupName="MainNavigation" Tag="4"
                                     Style="{StaticResource NavigationRadioStyle}" Checked="Navigation_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource GoldGradientBrush}" BorderBrush="{DynamicResource GoldLightBrush}" BorderThickness="0.5" HorizontalAlignment="Right">
                                    <Border.Effect><DropShadowEffect Color="#D2A34F" BlurRadius="8" ShadowDepth="2" Opacity="0.25" /></Border.Effect>
                                    <Viewbox Width="15" Height="15"><Path Data="M 1,6 L 8,2 15,6 M 2,7 L 14,7 M 3,8 L 3,13 M 8,8 L 8,13 M 13,8 L 13,13 M 1,14 L 15,14" Stroke="#173330" StrokeThickness="1.3" StrokeLineJoin="Round" /></Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" Text="تحلیل خزانه" VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="13" Margin="2,16,2,3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,0,0" />
                                <TextBlock Text="{Binding DataModeLabel}" FontWeight="Bold" Foreground="{DynamicResource GoldLightBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DataSourceDescription}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="نسخهٔ ۱.۱.۶ · مستقیم/نمایشی" Foreground="{DynamicResource GoldLightBrush}"
                                       FontSize="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource HeaderSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="16" Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Border Background="{DynamicResource BadgeSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                <TextBlock Text="{Binding DataModeLabel}" Foreground="{DynamicResource GoldLightBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Width="1" Height="24" Background="{DynamicResource StrokeBrush}" Margin="14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="کنسول مدیریتی میلانو" FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="{Binding TodayDateText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="اتصال SQL" Style="{StaticResource GoldButtonStyle}" VerticalAlignment="Center"
                                ToolTip="اتصال مستقیم، انتخاب دیتابیس و نگاشت داده‌های فقط‌خواندنی" Click="ConnectSql_Click" />
                        <Button x:Name="ThemeToggleButton" Grid.Column="2" Content="☼ تم روشن" MinWidth="112"
                                Style="{StaticResource BaseButtonStyle}" VerticalAlignment="Center" ToolTip="تغییر به تم روشن"
                                Click="ThemeToggle_Click" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                            <Button Style="{StaticResource WindowButtonStyle}" Content="⛶" ToolTip="تغییر حالت تمام‌صفحه (F11)" Click="ToggleFullScreen_Click" />
                            <Button Style="{StaticResource WindowButtonStyle}" Content="—" ToolTip="کوچک‌کردن پنجره" Click="Minimize_Click" />
                            <Button Style="{StaticResource WindowButtonStyle}" Content="□" ToolTip="بزرگ‌نمایی یا بازگردانی" Click="Maximize_Click" />
                            <Button Style="{StaticResource WindowButtonStyle}" Content="×" Foreground="{DynamicResource RedBrush}"
                                    ToolTip="بستن برنامه" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl x:Name="SectionTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabItem Focusable="False">
                        <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border MinHeight="{Binding ElementName=DashboardScrollViewer, Path=ViewportHeight}" Padding="22,12,22,22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,3,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="نبض مالی کسب‌وکار" FontSize="28" FontWeight="Bold" />
                                            <TextBlock Text="نمایی یکپارچه از فروش، تعهدها و سررسیدهای پیش‌رو" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="13" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource BadgeSurfaceBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1" CornerRadius="14"
                                                Padding="14,10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                                <TextBlock Text="●" Foreground="{DynamicResource GreenBrush}" Margin="0,0,7,0" />
                                                <TextBlock Text="منبع دادهٔ فعال" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1" Background="{DynamicResource NoticeSurfaceBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15,12" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="ⓘ" Grid.Column="0" Foreground="{DynamicResource GoldBrush}" FontSize="18" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DataModeLabel}" Foreground="{DynamicResource GoldLightBrush}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding DataSourceDescription}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <UniformGrid Grid.Row="2" Columns="4" Margin="-3,0,-3,16">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="15" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="فروش امروز" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding TodaySales}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TodaySales}" Margin="0,11,0,4" />
                                                <TextBlock Text="مجموع فروش" Foreground="{DynamicResource BlueBrush}" FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="15" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="ورودی · ۷ روز پیش‌رو" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding Incoming7}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Incoming7}" Margin="0,11,0,4" />
                                                <TextBlock Text="چک‌های دریافتی در انتظار" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="15" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="خروجی · ۷ روز پیش‌رو" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding Outgoing7}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource RedBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Outgoing7}" Margin="0,11,0,4" />
                                                <TextBlock Text="چک‌های پرداختی در انتظار" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="خالص · ۷ روز پیش‌رو" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding Net7}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource GoldLightBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Net7}" Margin="0,11,0,4" />
                                                <TextBlock Text="ورودی منهای خروجی" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Grid.Row="3" MinHeight="300">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.45*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                CornerRadius="18" Padding="17" Margin="0,0,8,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="روند فروش" FontSize="16" FontWeight="Bold" />
                                                        <TextBlock Text="تجمیع فروش هر روز · میلیون تومان" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SalesTotal}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Foreground="{DynamicResource GoldLightBrush}" FontWeight="SemiBold" FontSize="11" />
                                                </Grid>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding SalesChart}" Height="220">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Width="62" Margin="4,0">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="174" />
                                                                        <RowDefinition Height="24" />
                                                                        <RowDefinition Height="20" />
                                                                    </Grid.RowDefinitions>
                                                                    <Border Grid.Row="0" Background="{DynamicResource ChartTrackBrush}" CornerRadius="8" Height="164" VerticalAlignment="Bottom">
                                                                        <Border Height="{Binding ChartBarHeight}" VerticalAlignment="Bottom" CornerRadius="8"
                                                                                Background="{DynamicResource GoldGradientBrush}" Margin="5,0" />
                                                                    </Border>
                                                                    <TextBlock Grid.Row="1" Text="{Binding ChartAmountText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Row="2" Text="{Binding ShortDateText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                CornerRadius="18" Padding="17" Margin="8,0,0,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="سررسیدهای نزدیک" FontSize="16" FontWeight="Bold" />
                                                        <TextBlock Text="اولویت سررسیدهای فعال" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="{DynamicResource NotificationBrush}" CornerRadius="8" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="هشدار " Foreground="{DynamicResource GoldLightBrush}" FontSize="10" />
                                                            <TextBlock Text="{Binding Warnings}" Foreground="{DynamicResource GoldLightBrush}" FontSize="10" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding UpcomingChecks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource HeaderSurfaceBrush}" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1" CornerRadius="12"
                                                                    Padding="10" Margin="0,0,0,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="5" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="{DynamicResource GoldBrush}" CornerRadius="2" Margin="0,2,9,2" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Party}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding AmountText}" Foreground="{DynamicResource GoldLightBrush}" FontWeight="SemiBold" FontSize="11"
                                                                                   HorizontalAlignment="Left" />
                                                                        <TextBlock Text="{Binding DueDateText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"
                                                                                   HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="4" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                CornerRadius="14" Padding="14" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                                <TextBlock Text="●" Foreground="{DynamicResource RedBrush}" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="طرف‌حساب‌های پرریسک" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding RiskCustomers}" Foreground="{DynamicResource GoldLightBrush}" FontWeight="Bold" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                CornerRadius="14" Padding="14" Margin="6,0,0,0">
                                            <TextBlock Text="شاخص‌های نقدینگی، ماندهٔ آغازین صفر را فرض می‌کنند؛ پیش‌بینی، موجودی بانکی واقعی نیست."
                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Focusable="False">
                        <Grid Margin="20,14,20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="مرکز چک‌ها" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="جست‌وجو، فیلتر و بررسی تعهدهای نگاشت‌شده" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource BadgeSurfaceBrush}" BorderBrush="{DynamicResource SoftBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="انتخاب‌شده: " Foreground="{DynamicResource GoldLightBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding SelectedCountText}" Foreground="{DynamicResource GoldLightBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="15" Padding="10" Margin="0,0,0,10">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBox Width="220" Margin="3" ToolTip="جست‌وجو در شماره، طرف حساب، بانک و وضعیت"
                                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Width="145" Margin="3" ItemsSource="{Binding CheckTypeFilters}" SelectedItem="{Binding SelectedCheckType}" />
                                    <ComboBox Width="155" Margin="3" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" />
                                    <Button Content="ثبت وصول" Style="{StaticResource GoldButtonStyle}" IsEnabled="{Binding CanChangeStatus}" Click="Collect_Click" />
                                    <Button Content="ثبت پرداخت" IsEnabled="{Binding CanChangeStatus}" Click="Pay_Click" />
                                    <Button Content="برگشت" IsEnabled="{Binding CanChangeStatus}" Click="Return_Click" />
                                    <Button Content="تعلیق" IsEnabled="{Binding CanChangeStatus}" Click="Suspend_Click" />
                                    <Button Content="رفع تعلیق" IsEnabled="{Binding CanChangeStatus}" Click="Resume_Click" />
                                    <Button Content="خروجی CSV" Click="ChecksCsv_Click" />
                                    <Button Content="چاپ" Click="Print_Click" />
                                </WrapPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <DataGrid x:Name="ChecksGrid" ItemsSource="{Binding FilteredChecks}"
                                          SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ChecksGrid_SelectionChanged"
                                          CanUserSortColumns="True" CanUserReorderColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="شماره" Binding="{Binding Number}" Width="105" />
                                        <DataGridTextColumn Header="نوع" Binding="{Binding Kind}" Width="86" />
                                        <DataGridTextColumn Header="طرف حساب" Binding="{Binding Party}" Width="*" MinWidth="125" />
                                        <DataGridTextColumn Header="بانک" Binding="{Binding Bank}" Width="85" />
                                        <DataGridTextColumn Header="مبلغ · تومان" Binding="{Binding AmountText}" Width="160" />
                                        <DataGridTextColumn Header="سررسید · شمسی" Binding="{Binding DueDateText}" Width="120" />
                                        <DataGridTemplateColumn Header="وضعیت" Width="115">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SelectionSurfaceBrush}" BorderBrush="{DynamicResource StatusBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource GoldLightBrush}" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="امتیاز ریسک" Binding="{Binding RiskText}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="موردی با این معیارها پیدا نشد" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding HasNoFilteredChecks, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="15" Padding="13" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1.85*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="جمع انتخاب‌شده" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding SelectedTotal}" Foreground="{DynamicResource GoldLightBrush}" FontWeight="Bold" FontSize="14" Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding WeightedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="سناریوی جابه‌جایی سررسیدِ چک‌های دریافتیِ انتخاب‌شده" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ShiftDaysLabel}" HorizontalAlignment="Left" Foreground="{DynamicResource GoldLightBrush}"
                                                       FontSize="10" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="−۱۴" Grid.Column="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="-14" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding ShiftDays, Mode=TwoWay}" Margin="12,0" VerticalAlignment="Center" />
                                            <TextBlock Text="+۳۰" Grid.Column="2" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Foreground="{DynamicResource RedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap">
                                            <Run Text="کمترین ماندهٔ تجمعیِ سناریو (از صفر): " />
                                            <Run Text="{Binding SimulatedGap, Mode=OneWay}" FontWeight="Bold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Focusable="False">
                        <Grid Margin="20,14,20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="230" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="فروش و عملکرد" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="جمع‌بندی و نمودار از داده‌های فروش بارگذاری‌شده" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="خروجی CSV" HorizontalAlignment="Left" VerticalAlignment="Center" Click="SalesCsv_Click" />
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="3" Margin="-3,0,-3,10">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="فروش ثبت‌شده" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding SalesTotal}" Foreground="{DynamicResource GoldLightBrush}" FontWeight="Bold" FontSize="14" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="سود ثبت‌شده" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding SalesProfit}" Foreground="{DynamicResource GreenBrush}" FontWeight="Bold" FontSize="14" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="بیشترین فروش بر اساس مبلغ" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding TopCustomer}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TopCustomer}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="13" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="مقایسهٔ فروش روزانه · ۹۰ روز اخیر" FontSize="12" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="فروشندهٔ پیشتاز: " Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                            <TextBlock Text="{Binding TopSeller}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding SalesChart}" Height="180">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="84" Margin="5,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="152" />
                                                            <RowDefinition Height="20" />
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Background="{DynamicResource ChartTrackBrush}" CornerRadius="7" Height="146" VerticalAlignment="Bottom">
                                                            <Border Height="{Binding ChartBarHeight}" VerticalAlignment="Bottom" CornerRadius="7"
                                                                    Background="{DynamicResource GoldGradientBrush}" Margin="7,0" />
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding ShortDateText}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="3" ItemsSource="{Binding Sales}" CanUserReorderColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="تاریخ · شمسی" Binding="{Binding DateText}" Width="125" />
                                    <DataGridTextColumn Header="مشتری" Binding="{Binding Customer}" Width="*" MinWidth="135" />
                                    <DataGridTextColumn Header="فروشنده" Binding="{Binding Seller}" Width="*" MinWidth="120" />
                                    <DataGridTextColumn Header="مبلغ · تومان" Binding="{Binding AmountText}" Width="170" />
                                    <DataGridTextColumn Header="سود · تومان" Binding="{Binding ProfitText}" Width="160" />
                                    <DataGridTextColumn Header="وضعیت وصول" Binding="{Binding CollectionStatus}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Focusable="False">
                        <Grid Margin="20,14,20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="2,0,2,12">
                                <TextBlock Text="رادار نقدینگی" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="پیش‌بینی روزانهٔ ۳۰ روز آینده بر مبنای چک‌های در انتظار" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Background="{DynamicResource NoticeSurfaceBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,12">
                                <TextBlock Text="ماندهٔ آغازین صفر فرض شده است؛ این تصویر برآورد نمونه است، نه ماندهٔ بانکی یا پیش‌بینی مبتنی بر دادهٔ واقعی. تغییر سناریو در مرکز چک‌ها فقط چک‌های دریافتیِ انتخاب‌شده را جابه‌جا می‌کند."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </Border>

                            <UniformGrid Grid.Row="2" Columns="3" Margin="-3,0,-3,12">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="13" Padding="12" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="ورودی هفت‌روزه" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding Incoming7}" Foreground="{DynamicResource GreenBrush}" FontWeight="Bold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="13" Padding="12" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="خروجی هفت‌روزه" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding Outgoing7}" Foreground="{DynamicResource RedBrush}" FontWeight="Bold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="12" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="خالص هفت‌روزه" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding Net7}" Foreground="{DynamicResource GoldLightBrush}" FontWeight="Bold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <DataGrid Grid.Row="3" ItemsSource="{Binding Radar}" CanUserReorderColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="روز · شمسی" Binding="{Binding DayText}" Width="150" />
                                    <DataGridTextColumn Header="ورودی" Binding="{Binding IncomingText}" Width="*" />
                                    <DataGridTextColumn Header="خروجی" Binding="{Binding OutgoingText}" Width="*" />
                                    <DataGridTemplateColumn Header="ماندهٔ تجمعی از صفر" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BalanceText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                                            <Setter Property="FontSize" Value="13" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Focusable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,14,22,22" MinWidth="600">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="تحلیل سررسید خزانه" FontSize="24" FontWeight="Bold" />
                                        <TextBlock Text="دریافت‌ها و پرداخت‌های ناشی از چک · تفکیک شفاف سررسید و برگشتی" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="CSV جدول سررسید" Click="TreasuryCsv_Click" Style="{StaticResource GoldButtonStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Background="{DynamicResource NoticeSurfaceBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,14">
                                    <TextBlock Text="این گزارش فقط چک‌های موجود در snapshot را بررسی می‌کند؛ واریز، برداشت و ماندهٔ بانکی واقعی نیست. چک‌های معلق یا تسویه‌شده در سررسیدها نیستند؛ برگشتی‌ها جداگانه نمایش داده می‌شوند. نسبت پوشش، فقط مقایسهٔ چک‌های در انتظار است، نه تضمین وصول." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding TreasuryAsOf}" Foreground="{DynamicResource GoldLightBrush}" FontWeight="SemiBold" Margin="2,0,2,8" />
                                <UniformGrid Columns="2" Margin="-4,0,-4,12">
                                    <Border Margin="4" Padding="16" CornerRadius="15" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <StackPanel><TextBlock Text="دریافتیِ سررسیدگذشته" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding OverdueIncoming}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                                    </Border>
                                    <Border Margin="4" Padding="16" CornerRadius="15" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <StackPanel><TextBlock Text="پرداختیِ سررسیدگذشته" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding OverdueOutgoing}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                                    </Border>
                                    <Border Margin="4" Padding="16" CornerRadius="15" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <StackPanel><TextBlock Text="چک دریافتی برگشتی" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding ReturnedIncoming}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GoldLightBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                                    </Border>
                                    <Border Margin="4" Padding="16" CornerRadius="15" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <StackPanel><TextBlock Text="چک پرداختی برگشتی" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding ReturnedOutgoing}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GoldLightBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Border Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="15" Padding="15" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="نسبت پوشش تعهدات تا ۳۰ روز آینده" FontSize="15" FontWeight="Bold" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="دریافتی در انتظار: " Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding TreasuryIncoming30}" Foreground="{DynamicResource GreenBrush}" FontWeight="SemiBold" Margin="0,0,18,0" />
                                            <TextBlock Text="پرداختی در انتظار: " Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding TreasuryOutgoing30}" Foreground="{DynamicResource RedBrush}" FontWeight="SemiBold" Margin="0,0,18,0" />
                                            <TextBlock Text="پوشش: " Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding TreasuryCoverage}" Foreground="{DynamicResource GoldLightBrush}" FontWeight="Bold" />
                                        </WrapPanel>
                                        <TextBlock Text="فرمول: دریافتی ÷ پرداختی × ۱۰۰؛ شامل همهٔ سررسیدگذشته‌ها و امروز تا روز ۳۰. در نبود پرداختی، نسبت نامشخص است (—)." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="جدول تفکیک سررسید چک‌های در انتظار" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                <DataGrid Height="400" ItemsSource="{Binding TreasuryBuckets}" CanUserSortColumns="False" CanUserReorderColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="دوره" Binding="{Binding Label}" Width="220" />
                                        <DataGridTextColumn Header="تعداد دریافتی" Binding="{Binding IncomingCountText}" Width="115" />
                                        <DataGridTextColumn Header="دریافتی · تومان" Binding="{Binding IncomingText}" Width="170" />
                                        <DataGridTextColumn Header="تعداد پرداختی" Binding="{Binding OutgoingCountText}" Width="115" />
                                        <DataGridTextColumn Header="پرداختی · تومان" Binding="{Binding OutgoingText}" Width="170" />
                                        <DataGridTextColumn Header="خالص · تومان" Binding="{Binding NetText}" Width="170" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
