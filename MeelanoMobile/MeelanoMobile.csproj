<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MeelanoMobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>میلانو</ApplicationTitle>
    <ApplicationId>com.meelano.executive.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.130" />
    <ProjectReference Include="../MeelanoExecutiveConsole.Core/MeelanoExecutiveConsole.Core.csproj" />
    <MauiFont Include="Resources/Fonts/*.ttf" />
    <MauiAsset Include="Resources/Fonts/OFL.txt" LogicalName="OFL.txt" />
    <MauiSplashScreen Include="Resources/AppIcon/appicon.svg" Color="#081315" BaseSize="128,128" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#101D20" />
  </ItemGroup>
</Project>
